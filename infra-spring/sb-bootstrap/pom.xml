<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mpumd.poc</groupId>
        <artifactId>infra-spring</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sb-bootstrap</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.mpumd.poc</groupId>
            <artifactId>sb-in</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mpumd.poc</groupId>
            <artifactId>sb-out</artifactId>
        </dependency>

        <dependency>
            <groupId>de.codecentric</groupId>
            <artifactId>spring-boot-admin-starter-server</artifactId>
        </dependency>
        <dependency>
            <groupId>de.codecentric</groupId>
            <artifactId>spring-boot-admin-starter-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-spring</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- optimized jvm image, buildpacks so no dockerfile : mvn -Pjvm-image package
                 Needs the docker daemon on /var/run/docker.sock. Never point DOCKER_HOST at a rootless
                 podman socket : the lifecycle container cannot reach it, SELinux labels it user_tmp_t
                 while containers run as container_t, and the exporter dies on "failed to fetch base
                 layers". That variable also wins over <docker><host>, so no pom setting can rescue it.
                 Out of the default build : needs docker, and its CGLIB proxies break the JVM ITs. -->
            <id>jvm-image</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <image>
                                <name>person.msvc.spring:${project.version}</name>
                                <!-- prod ubuntu LTS 24 -->
                                <builder>paketobuildpacks/builder-noble-java-tiny:latest</builder>
                                <runImage>paketobuildpacks/ubuntu-noble-run-tiny:latest</runImage>
                                <!-- with tools like bash -->
<!--                                 <builder>paketobuildpacks/ubuntu-noble-builder:latest</builder>-->
<!--                                 <runImage>paketobuildpacks/ubuntu-noble-run:latest</runImage>-->
                                <env>
                                    <BP_JVM_VERSION>${java.version}</BP_JVM_VERSION>
                                    <BP_JVM_AOTCACHE_ENABLED>true</BP_JVM_AOTCACHE_ENABLED>
                                    <!-- TODO jvm aot cache (java 25, leyden) : training run done by the buildpack.
                                         off until paketo-buildpacks/spring-boot#581 is fixed : the cache is
                                         created, then "unable to contribute spring-performance layer" -->
                                    <!-- jre trimmed to the used modules : smaller image -->
                                    <BP_SPRING_AOT_ENABLED>false</BP_SPRING_AOT_ENABLED> <!-- build static factory -->
                                    <BPL_SPRING_AOT_ENABLED>false</BPL_SPRING_AOT_ENABLED> <!-- run AOT mode -->
                                    <BP_JVM_JLINK_ENABLED>true</BP_JVM_JLINK_ENABLED>
                                </env>
                            </image>
                        </configuration>
                        <executions>
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>build-image</id>
                                <phase>package</phase>
                                <goals>
                                    <!-- no-fork : don't run maven package phase in a second time -->
                                    <goal>build-image-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>openapi-spec-generator</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration combine.children="append">
                            <jvmArguments>
                                -Dspring.application.admin.enabled=disabled
                                -Dspringdoc.api-docs.enabled=true
                                -Dserver.port=8090
                                -Dserver.servlet.context-path=/
                            </jvmArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>start-for-springdoc-plugin</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>start</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>stop-for-springdoc-plugin</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>stop</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.springdoc</groupId>
                        <artifactId>springdoc-openapi-maven-plugin</artifactId>
                        <version>${springdoc-openapi-plugin.version}</version>
                        <configuration>
                            <apiDocsUrl>http://localhost:8090/api-docs.yaml</apiDocsUrl>
                            <!-- <outputDir>${project.build.outputDirectory}</outputDir>-->
                            <outputFileName>openapi.yaml</outputFileName>
                        </configuration>
                        <executions>
                            <execution>
                                <id>generate-openapi-yaml</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>generate-openapi-json</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <apiDocsUrl>http://localhost:8090/api-docs</apiDocsUrl>
                                    <outputFileName>openapi.json</outputFileName>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>