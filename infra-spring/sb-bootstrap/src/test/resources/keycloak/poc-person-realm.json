{
  "attributes": {
    "_comment": "Each test uses only some of these roles / users, the others are unused on purpose : this file must stay strictly identical everywhere in the app so that every test reuses the same keycloak container (its content feeds the testcontainers reuse hash)."
  },
  "realm": "poc-person",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "can act on an already registered person"
      },
      {
        "name": "ADMIN",
        "description": "can register a new person"
      },
      {
        "name": "OPS",
        "description": "can reach the protected actuator endpoints"
      },
      {
        "name": "GRANTED",
        "description": "synthetic role for the security tests : proves the keycloak -> spring authority bridge and that access passes, without coupling to a business role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "poc-person-app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "users": [
